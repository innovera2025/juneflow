# @juneflow/notifications — environment variables (example)
# Copy to .env and fill in real values. NEVER commit real secrets (PLAN.md §10).
# Credentials load via packages/notifications/src/config.ts (loadNotificationsConfig).

# Driver selector — mock-first default is "fake" (no credentials needed).
# Set to "real" to use the live adapters (requires the channel vars below).
NOTIFICATIONS_DRIVER=fake

# --- LINE Messaging API (message delivery; LIFF UI lives in apps/web) ---
LINE_CHANNEL_ACCESS_TOKEN=replace-with-real-line-channel-access-token
LINE_CHANNEL_SECRET=replace-with-real-line-channel-secret

# --- Email (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-real-smtp-password
EMAIL_FROM=noreply@example.com

# --- Web Push (VAPID; browser push only — native FCM/APNs deferred) ---
WEBPUSH_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
WEBPUSH_VAPID_PRIVATE_KEY=replace-with-real-vapid-private-key
WEBPUSH_VAPID_SUBJECT=mailto:admin@example.com
