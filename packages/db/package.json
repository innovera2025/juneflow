{
  "name": "@juneflow/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Juneflow DB - Drizzle schema (data-dictionary + PLAN.md Appendix B) + seed from MOCK-DATA.md",
  "exports": {
    ".": {
      "development": "./src/schema/index.ts",
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./schema": {
      "development": "./src/schema/index.ts",
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./client": {
      "development": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./seed/packages": {
      "development": "./src/seed/packages.ts",
      "types": "./dist/seed/packages.d.ts",
      "default": "./dist/seed/packages.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "node --import tsx ./node_modules/drizzle-kit/bin.cjs generate",
    "migrate": "drizzle-kit migrate",
    "migration:check": "drizzle-kit check",
    "seed": "tsx src/seed/index.ts",
    "quota:preflight": "tsx src/quota-preflight.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "better-auth": "^1.2.8",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.0"
  }
}
