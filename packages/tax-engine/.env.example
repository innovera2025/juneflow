# @juneflow/tax-engine — environment variables (example)
# Copy to .env and fill in real values. NEVER commit real secrets (PLAN.md §10).
# Credentials load via packages/tax-engine/src/config.ts (loadTaxEngineConfig).

# Driver selector — mock-first default is "fake" (no credentials needed).
# Set to "thailand" to use the real e-Tax integration (requires the vars below).
TAX_ENGINE_DRIVER=fake

# --- e-Tax (Thai Revenue Department) — required only when TAX_ENGINE_DRIVER=thailand ---
ETAX_API_BASE_URL=https://etax.example.rd.go.th
ETAX_API_KEY=replace-with-real-etax-api-key
# Path to the signing certificate on the host (mounted via infra, never committed).
ETAX_CERT_PATH=/run/secrets/etax-cert.p12
