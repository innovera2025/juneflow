# @juneflow/bank-file — environment variables (example)
# Copy to .env and fill in real values. NEVER commit real secrets (PLAN.md §10).
# Credentials load via packages/bank-file/src/config.ts (loadBankFileConfig).

# Driver selector — mock-first default is "fake" (no credentials needed).
# Set to "kbank-direct" to use the real formatter (requires the vars below).
BANK_FILE_DRIVER=fake

# --- KBANK Direct — required only when BANK_FILE_DRIVER=kbank-direct ---
KBANK_DIRECT_COMPANY_CODE=replace-with-kbank-company-code
KBANK_DIRECT_API_KEY=replace-with-real-kbank-api-key
