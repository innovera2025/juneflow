{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // Resolve @juneflow/db to its TS source (its `development` export condition)
    // so typecheck/vitest need no prior db build; production `node dist/index.js`
    // still resolves the compiled JS via the `default` condition (P0-FIX-08).
    "customConditions": ["development"],
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
