# Juneflow environment variables (example — copy to .env and fill in real values)
# Never commit real secrets. See infra/CLAUDE.md and PLAN.md section 5.

# --- Database (PostgreSQL 16) ---
DATABASE_URL=postgresql://juneflow:juneflow@localhost:5432/juneflow

# --- Queue (Redis + BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- File storage (Cloudflare R2, presigned upload via POST /files) ---
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=juneflow-dev

# --- Auth (better-auth, self-hosted in Postgres) ---
BETTER_AUTH_SECRET=change-me-generate-a-long-random-string

# --- LINE Login channel (custom LINE Login/LIFF) ---
LINE_CHANNEL_ID=your-line-login-channel-id
LINE_CHANNEL_SECRET=your-line-login-channel-secret

# --- App ---
APP_BASE_URL=http://localhost:5173
