{
  "_comment": "Per-agent autonomous-loop config (Bootstrap Manifest v2 group 4.2 + PLAN.md §10). Zones per PLAN.md §8. maxRoundsPerNight / budgetUsdPerNight are the per-night caps read by scripts/loop-runner.sh — Wei tunes these values.",
  "defaults": {
    "_comment": "Fallbacks when an agent entry omits a cap. claudeFlags are passed to every headless `claude -p` round; the loop is unattended so permission prompts cannot be answered — override with the LOOP_CLAUDE_FLAGS env var if a stricter mode is wanted.",
    "maxRoundsPerNight": 10,
    "budgetUsdPerNight": 20,
    "claudeFlags": [
      "--dangerously-skip-permissions"
    ]
  },
  "agents": {
    "backend": {
      "zonePaths": [
        "apps/api",
        "packages/db",
        "packages/contracts"
      ],
      "zoneClaudeMd": "apps/api/CLAUDE.md",
      "featureBranch": "feature/backend",
      "maxRoundsPerNight": 10,
      "budgetUsdPerNight": 20
    },
    "web": {
      "zonePaths": [
        "apps/web"
      ],
      "zoneClaudeMd": "apps/web/CLAUDE.md",
      "featureBranch": "feature/web",
      "maxRoundsPerNight": 10,
      "budgetUsdPerNight": 20
    },
    "mobile": {
      "zonePaths": [
        "apps/mobile"
      ],
      "zoneClaudeMd": "apps/mobile/CLAUDE.md",
      "featureBranch": "feature/mobile",
      "maxRoundsPerNight": 10,
      "budgetUsdPerNight": 20
    },
    "qa": {
      "zonePaths": [
        "tests"
      ],
      "zoneClaudeMd": "tests/CLAUDE.md",
      "featureBranch": "feature/qa",
      "maxRoundsPerNight": 10,
      "budgetUsdPerNight": 20
    },
    "integrations": {
      "zonePaths": [
        "packages/tax-engine",
        "packages/bank-file",
        "packages/notifications"
      ],
      "zoneClaudeMd": "packages/integrations/CLAUDE.md",
      "featureBranch": "feature/integrations",
      "maxRoundsPerNight": 10,
      "budgetUsdPerNight": 20
    },
    "devops": {
      "zonePaths": [
        "infra",
        "scripts",
        ".github"
      ],
      "zoneClaudeMd": "infra/CLAUDE.md",
      "featureBranch": "feature/devops",
      "maxRoundsPerNight": 10,
      "budgetUsdPerNight": 20
    },
    "platform": {
      "_comment": "Platform zone (7th, B-032): monorepo tooling + shared token/i18n packages that no app zone owns. Owns root build/CI config so docker build + CI test scripts + tokens/i18n have a home.",
      "zonePaths": [
        "package.json",
        "turbo.json",
        "tsconfig.base.json",
        "pnpm-workspace.yaml",
        "pnpm-lock.yaml",
        ".dockerignore",
        "packages/tokens",
        "packages/i18n"
      ],
      "zoneClaudeMd": "CLAUDE.md",
      "featureBranch": "feature/platform",
      "maxRoundsPerNight": 10,
      "budgetUsdPerNight": 20
    }
  }
}
